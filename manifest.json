{
  "manifest_version": 3,
  "name": "PawnForge Coach Overlay",
  "version": "0.6.0",
  "description": "Shows the next Stockfish move over chessboards in Chrome.",
  "action": {
    "default_title": "Toggle PawnForge Coach"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
