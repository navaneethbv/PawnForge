{
  "name": "pawnforge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "PawnForge full-stack chess analysis web app",
  "scripts": {
    "serve": "node server.js",
    "start": "node server.js",
    "check": "node --check server.js && node --check chess-analysis.js && node --check engine-worker.js && node --check src/main.js && node --check overlay.js && node --check background.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "check:extension": "node scripts/check-extension.js"
  },
  "devDependencies": {
    "@chrisoakman/chessboardjs": "1.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "chess.js": "1.1.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jquery": "3.7.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
