{
  "manifest_version": 3,
  "name": "PawnForge Coach Overlay",
  "version": "0.4.0",
  "description": "Shows the next Stockfish move over chessboards in Chrome.",
  "action": {
    "default_title": "Toggle PawnForge Coach"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.chess.com/*",
    "*://*.lichess.org/*",
    "*://*.chesstempo.com/*",
    "*://*.chess.org/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.chess.com/*", "*://*.lichess.org/*", "*://*.chesstempo.com/*", "*://*.chess.org/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
